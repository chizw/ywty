# =========================================
# ywty 环境变量（全部可选！不配置也能跑）
# Docker 部署默认零配置：JWT 密钥自动生成并持久化到数据卷
# 站点名称/描述/页脚/注册开关等在 /admin/settings 后台修改即可
# =========================================

# —— 常用 ——
# JWT 密钥（集群多实例或想固定密钥时才需要设置；单容器部署无需理会）
#JWT_SECRET=
# 对外访问地址（生成链接、OAuth 回调用；反代到域名后建议设置）
#APP_URL=http://localhost:3000

# —— 数据库（默认 SQLite，零依赖）——
#DB_DRIVER=sqlite
#DB_PATH=./data/ywty.db
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_USER=ywty
#DB_PASSWORD=
#DB_NAME=ywty

# —— Redis 缓存（可选，不设则无缓存）——
#REDIS_ADDR=127.0.0.1:6379
#REDIS_PASSWORD=
#REDIS_DB=0

# —— 存储 ——
#STORAGE_DRIVER=local
#STORAGE_ROOT=./uploads
# 图片外链前缀（默认 {APP_URL}/uploads，一般不用改）
#STORAGE_URL=

# —— 服务监听 ——
#PORT=3000
#HOST=0.0.0.0
