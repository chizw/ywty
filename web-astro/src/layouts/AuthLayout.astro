---
// 认证布局：渐变背景 + 居中卡片 + 品牌 Logo（站名由站点信息接口驱动）
import { getSiteInfo } from '../lib/site'

const site = await getSiteInfo()
const sealChar = site.name.slice(-1)
---

<div class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-background via-accent/40 to-brand/20 px-4 py-12">
  <!-- 背景装饰光斑 -->
  <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-brand/20 blur-3xl" />
  <div class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-sky-500/20 blur-3xl" />

  <div class="relative w-full max-w-md">
    <a href="/" class="group mb-8 flex items-center justify-center gap-2.5">
      <span class="font-display text-2xl font-bold tracking-tight text-foreground">
        {site.name}
      </span>
      <span class="seal h-7 w-7 text-xs transition-transform group-hover:-rotate-3" aria-label={sealChar}>
        {sealChar}
      </span>
    </a>
    <div class="rounded-md border hairline bg-card p-8 shadow-[0_16px_40px_-24px_hsl(var(--brand)/0.35)]">
      <slot />
    </div>
    <p class="mt-8 text-center text-xs text-muted-foreground">
      &copy; {new Date().getFullYear()} {site.name}
    </p>
  </div>
</div>
