---
// 探索页：浏览公开图片（静态部署，客户端拉取）
import BaseLayout from '../../layouts/BaseLayout.astro'
import PublicLayout from '../../layouts/PublicLayout.astro'
import PhotoExplore from '../../components/vue/explore/PhotoExplore.vue'
---

<BaseLayout title="探索" description="浏览社区公开图片">
  <PublicLayout>
    <section class="container-site py-10 sm:py-12">
      <div class="border-b hairline pb-5">
        <h1 class="font-display text-3xl font-bold tracking-tight">探索</h1>
        <p class="mt-2 text-sm text-muted-foreground">社区公开的图片，随手翻看。</p>
      </div>
      <PhotoExplore client:load />
    </section>
  </PublicLayout>
</BaseLayout>
