---
// 首页：editorial hero + 接触印相 + 登记册 + 题跋结尾
import BaseLayout from '../layouts/BaseLayout.astro'
import PublicLayout from '../layouts/PublicLayout.astro'
import HomeStrip from '../components/vue/home/HomeStrip.vue'
import HeroPlate from '../components/vue/home/HeroPlate.vue'

const register = [
  {
    label: '自托管',
    desc: '图片与数据，始终存于你自己的服务器。没有审查，没有额度焦虑。',
  },
  {
    label: '直链与引用',
    desc: '上传即得直链，Markdown 与 HTML 一键引用，写博客随手就用。',
  },
  {
    label: '分享可控',
    desc: '链接可设密码与有效期，也可公开浏览。谁来、看多久，由你决定。',
  },
  {
    label: '开放接口',
    desc: '完整 RESTful API，任意客户端皆可接入。你的图床，随你编排。',
  },
]
---

<BaseLayout>
  <PublicLayout>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="animate-mist absolute -top-40 left-[10%] h-[26rem] w-[42rem] rounded-full bg-brand/[0.05] blur-3xl" />
        <div class="absolute right-[-8rem] top-16 h-72 w-72 rounded-full bg-secondary/[0.06] blur-3xl" />
      </div>

      <div class="container-site pb-16 pt-20 sm:pb-24 sm:pt-28">
        <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.05fr]">
          <!-- 左：文案 -->
          <div>
            <p class="eyebrow">Self-Hosted Image Hosting · 自托管图床</p>

            <h1 class="mt-7 font-display text-[2.75rem] font-bold leading-[1.12] tracking-tight sm:text-6xl lg:text-[4rem]">
              图片的驿站。
            </h1>

            <p class="mt-6 max-w-md text-[1.05rem] leading-relaxed text-muted-foreground">
              自托管图床与云相册。图片归你所有，分享由你掌控。
            </p>

            <div class="mt-9 flex items-center gap-7">
              <a href="/explore" class="group inline-flex items-center gap-2 text-[0.95rem] font-medium text-foreground transition-colors hover:text-brand">
                开始探索
                <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
              </a>
              <a href="/auth/register" class="inline-flex items-center rounded-md border hairline px-4 py-2 text-[0.95rem] text-muted-foreground transition-colors hover:border-brand/50 hover:text-brand">
                创建账号
              </a>
            </div>
          </div>

          <!-- 右：相片标本卡 -->
          <div class="flex justify-center lg:justify-end">
            <HeroPlate client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- 接触印相：最新公开图片 -->
    <section class="container-site pb-20">
      <div class="flex items-baseline justify-between border-b hairline pb-3">
        <h2 class="font-display text-xl font-semibold">最新公开图片</h2>
        <a href="/explore" class="eyebrow transition-colors hover:text-brand">全部 →</a>
      </div>

      <div class="mt-6">
        <HomeStrip client:visible />
      </div>
    </section>

    <!-- 登记册：这里做什么 -->
    <section class="container-site pb-20">
      <h2 class="eyebrow mb-2">这里做什么</h2>
      <div class="mt-2">
        {
          register.map((item) => (
            <div class="register-item">
              <span class="font-display text-[1.05rem] font-semibold">{item.label}</span>
              <p class="max-w-xl text-[0.95rem] leading-relaxed text-muted-foreground">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 题跋结尾 -->
    <section class="container-site pb-24">
      <div class="border-t hairline pt-16 text-center">
        <p class="font-display text-2xl font-semibold sm:text-3xl">
          每一张图片，都该有落脚的地方。
        </p>
        <a href="/explore" class="group mt-7 inline-flex items-center gap-2 text-[0.95rem] font-medium text-brand">
          开始探索
          <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </a>
      </div>
    </section>
  </PublicLayout>
</BaseLayout>
