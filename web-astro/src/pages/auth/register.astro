---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AuthLayout from '../../layouts/AuthLayout.astro'
import RegisterForm from '../../components/vue/auth/RegisterForm.vue'
import { getSiteInfo } from '../../lib/site'

const site = await getSiteInfo()
---

<BaseLayout title="注册">
  <AuthLayout>
    {site.allow_register ? (
      <RegisterForm client:load site-name={site.name} />
    ) : (
      <div class="py-4 text-center">
        <h1 class="font-display text-2xl font-bold tracking-tight">注册</h1>
        <p class="mt-3 text-sm text-muted-foreground">本站已关闭注册</p>
        <p class="mt-8 text-center text-sm text-muted-foreground">
          已有账号？
          <a href="/auth/login" class="font-medium text-brand hover:underline">去登录</a>
        </p>
      </div>
    )}
  </AuthLayout>
</BaseLayout>
