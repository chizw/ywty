---
// 套餐展示页：SSR 拉取套餐列表与价格，CTA 指向登录/控制台
import BaseLayout from '../layouts/BaseLayout.astro'
import PublicLayout from '../layouts/PublicLayout.astro'
import { useApi } from '../lib/api'

interface Plan {
  id: number
  type: string
  name: string
  intro?: string | null
  features?: string | null
  badge: string
  sort: number
  is_up: number
}

interface PlanPrice {
  id: number
  name: string
  duration: number
  price: number
}

interface PlanDetail {
  plan: Plan
  prices: PlanPrice[]
}

let plans: Plan[] = []
let details: (PlanDetail | null)[] = []
try {
  plans = (await useApi().get<Plan[]>('/api/v1/plans')) || []
  details = await Promise.all(
    plans.map((p) => useApi().get<PlanDetail>(`/api/v1/plans/${p.id}`).catch(() => null))
  )
} catch {
  plans = []
}

const isLoggedIn = !!Astro.locals.auth
const fullPlans = plans.map((p, i) => ({
  plan: p,
  detail: details[i] || null,
}))
---

<BaseLayout title="套餐" description="选择适合你的存储套餐">
  <PublicLayout>
    <section class="container-site py-12">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Plans · 套餐</p>
        <h1 class="font-display mt-4 text-4xl font-bold tracking-tight">存储套餐</h1>
        <p class="mt-3 text-muted-foreground">自托管也从容，按需选一座够大的驿站。</p>
      </div>

      {
        plans.length > 0 ? (
          <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
              fullPlans.map(({ plan, detail }) => {
                const price = detail?.prices?.[0]
                const features = (plan.features || '').split('\n').filter(Boolean)
                return (
                  <div
                    class={`card-hover relative flex flex-col rounded-2xl border bg-card p-6 shadow-sm ${
                      plan.badge === 'popular' ? 'border-brand/40 ring-2 ring-brand/20' : 'border-border'
                    }`}
                  >
                    {plan.badge === 'popular' && (
                      <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand px-3 py-0.5 text-xs font-semibold text-brand-foreground">
                        推荐
                      </span>
                    )}
                    <div class="flex items-center justify-between">
                      <h3 class="text-xl font-bold text-foreground">{plan.name}</h3>
                    </div>
                    <p class="mt-2 min-h-10 text-sm text-muted-foreground">{plan.intro || '为普通用户打造的轻量存储套餐'}</p>

                    <div class="mt-5 flex items-baseline gap-1">
                      <span class="text-3xl font-extrabold text-foreground">
                        {price ? `¥${(price.price / 100).toFixed(2)}` : '联系了解'}
                      </span>
                      <span class="text-sm text-muted-foreground">
                        {price ? `/ ${price.duration} 天` : ''}
                      </span>
                    </div>

                    <ul class="mt-6 space-y-2.5 text-sm">
                      {features.map((f) => (
                        <li class="flex items-start gap-2 text-muted-foreground">
                          <span class="mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded-full bg-brand/10 text-[10px] text-brand">✓</span>
                          {f}
                        </li>
                      ))}
                    </ul>

                    <div class="mt-8 flex-1 flex items-end">
                      {isLoggedIn ? (
                        <a href={`/dashboard/plans/${plan.id}`} class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary text-sm font-medium text-primary-foreground shadow transition-all hover:bg-primary/90 active:scale-[0.98]">
                          立即开通
                        </a>
                      ) : (
                        <a href={`/auth/register?redirect=/dashboard/plans/${plan.id}`} class="inline-flex h-10 w-full items-center justify-center rounded-md border border-input bg-background text-sm font-medium shadow-sm transition-all hover:bg-accent hover:text-accent-foreground active:scale-[0.98]">
                          注册后开通
                        </a>
                      )}
                    </div>
                  </div>
                )
              })
            }
          </div>
        ) : (
          <div class="rounded-xl border border-dashed border-border py-24 text-center text-muted-foreground">
            套餐数据暂不可用
          </div>
        )
      }
    </section>
  </PublicLayout>
</BaseLayout>
