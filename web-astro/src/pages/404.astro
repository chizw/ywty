---
import BaseLayout from '../layouts/BaseLayout.astro'
import PublicLayout from '../layouts/PublicLayout.astro'
---

<BaseLayout title="页面不存在">
  <PublicLayout>
    <section class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <p class="text-7xl font-extrabold text-brand/30">404</p>
      <h1 class="mt-4 text-2xl font-bold text-foreground">页面不存在</h1>
      <p class="mt-2 text-muted-foreground">你访问的页面可能已被移动或删除</p>
      <div class="mt-8 flex gap-3">
        <a href="/">
          <span class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow transition-all hover:bg-primary/90">
            返回首页
          </span>
        </a>
        <a href="/explore">
          <span class="inline-flex h-10 items-center justify-center rounded-md border border-input bg-background px-6 text-sm font-medium shadow-sm transition-all hover:bg-accent hover:text-accent-foreground">
            去探索
          </span>
        </a>
      </div>
    </section>
  </PublicLayout>
</BaseLayout>
