# 应用环境: dev, prod
YWTY_APP_ENV=dev

# 服务端口
YWTY_APP_PORT=3000

# 数据库配置
YWTY_DATABASE_DRIVER=sqlite
YWTY_DATABASE_PATH=./data/ywty.db

# MySQL 配置（当 driver=mysql 时启用）
# YWTY_DATABASE_HOST=127.0.0.1
# YWTY_DATABASE_PORT=3306
# YWTY_DATABASE_USERNAME=root
# YWTY_DATABASE_PASSWORD=your-password
# YWTY_DATABASE_DATABASE=ywty

# Redis 配置
YWTY_REDIS_ADDR=127.0.0.1:6379
# YWTY_REDIS_PASSWORD=

# JWT 密钥（生产环境必须修改！）
YWTY_AUTH_JWT_SECRET=please-change-me-in-production-please-change-me

# 存储配置
YWTY_STORAGE_DRIVER=local
YWTY_STORAGE_ROOT=./uploads
