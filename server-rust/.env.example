# =========================================
# ywty 后端开发环境变量示例（全部可选）
# 短变量名直接覆盖 config.yaml 同名字段，详见 crates/core_lib/src/config.rs
# =========================================

# 服务监听
PORT=3000
HOST=0.0.0.0

# 站点对外地址
APP_URL=http://localhost:3000

# JWT 密钥（生产必须改）
JWT_SECRET=please-change-me

# 数据库（默认 sqlite）
DB_DRIVER=sqlite
DB_PATH=./data/ywty.db

# Redis（可选）
REDIS_ADDR=127.0.0.1:6379

# 存储
STORAGE_DRIVER=local
STORAGE_ROOT=./uploads
