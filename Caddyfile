{
	admin off
}

:3000 {
	root * /srv
	encode zstd gzip

	# 后端 API 与图片资源 → Rust 服务（本容器内 3001）
	@backend path /api/* /uploads/* /i/* /healthz
	handle @backend {
		reverse_proxy 127.0.0.1:3001
	}

	# 前端参数化路由：由服务器回退到对应静态壳，客户端解析路径拉数据
	@share path /s/*
	handle @share {
		try_files {path} /share/index.html
	}
	@albums path /dashboard/albums/*
	handle @albums {
		try_files {path} /dashboard/albums/index.html
	}
	@tickets path /dashboard/tickets/*
	handle @tickets {
		try_files {path} /dashboard/tickets/index.html
	}
	@custpage path /page/*
	handle @custpage {
		try_files {path} /page/index.html
	}

	# 其余：真实静态文件优先；未命中返回自定义 404
	handle {
		try_files {path} {path}/index.html
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}

	file_server
}
